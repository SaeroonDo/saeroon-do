 ---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Horarios | Saeroon Do"
  description="Consulta los horarios de entrenamiento de Taekwondo de Saeroon Do."
>

  <main>

    <!-- =========================================================
         HERO
    ========================================================== -->
    <section class="schedule-hero">

      <div class="schedule-hero-overlay"></div>

      <div class="hero-content">

        <div class="hero-text">

          <p class="quote-korean" lang="ko">
            새로운도
          </p>

          <p class="section-label">
            SAEROON DO
          </p>

          <h1>
            NUESTROS
            <span>HORARIOS</span>
          </h1>

          <p class="hero-description">
            Encuentra el horario que mejor se adapte a tu etapa
            de formación y comienza tu camino en el Taekwondo.
          </p>

        </div>


        <div class="hero-image">

          <img
            src="/images/logo Corea.jpg"
            alt="Corea y Taekwondo"
            loading="eager"
          />

        </div>

      </div>

    </section>


    <!-- =========================================================
         INTRODUCCIÓN
    ========================================================== -->
    <section class="intro section-block">

      <div class="container">

        <p class="section-label">
          ORGANIZA TU ENTRENAMIENTO
        </p>

        <h2 class="section-title">
          ELIGE TU <br>
          <span>HORARIO</span>
        </h2>

        <div class="gold-line"></div>

        <p class="intro-text">
          En Saeroon Do contamos con horarios pensados para
          acompañar cada etapa de formación. La constancia
          y la disciplina son parte fundamental de nuestro camino.
        </p>

      </div>

    </section>


    <!-- =========================================================
         HORARIOS
    ========================================================== -->
    <section class="schedule-section section-block alt-bg">

      <div class="container">

        <div class="section-heading">

          <p class="section-label">
            NUESTROS ENTRENAMIENTOS
          </p>

          <h2 class="section-title">
            ENCUENTRA TU <br>
            <span>MOMENTO</span>
          </h2>

          <div class="gold-line"></div>

          <p class="section-description">
            Elige el horario correspondiente a tu etapa de formación
            y haz del entrenamiento parte de tu camino.
          </p>

        </div>


        <div class="schedule-grid">


          <!-- =====================================================
               INFANTIL
          ====================================================== -->
          <article class="schedule-card">

            <div
              class="card-watermark infantil-watermark"
              aria-hidden="true"
            ></div>

            <div class="card-content">

              <div class="card-top">


                <p class="card-label">
                  FORMACIÓN INFANTIL
                </p>

                <h3>
                  4 A 10
                  <span>AÑOS</span>
                </h3>

              </div>


              <div class="gold-line left"></div>


              <div class="schedule-list">


                <div class="schedule-item">

                  <div class="day">

                    <strong>
                      MARTES Y JUEVES
                    </strong>

                    <span>
                      ENTRENAMIENTO
                    </span>

                  </div>

                  <div class="time">
                    5:00 p. m.
                    <small>—</small>
                    6:30 p. m.
                  </div>

                </div>


                <div class="schedule-item">

                  <div class="day">

                    <strong>
                      SÁBADOS Y DOMINGOS
                    </strong>

                    <span>
                      ENTRENAMIENTO
                    </span>

                  </div>

                  <div class="time">
                    9:00 a. m.
                    <small>—</small>
                    10:30 a. m.
                  </div>

                </div>


              </div>


              <a
                href="/contacto"
                class="schedule-button"
              >
                QUIERO ENTRENAR
                <span>→</span>
              </a>

            </div>

          </article>


          <!-- =====================================================
               JUVENIL Y ADULTOS
          ====================================================== -->
          <article class="schedule-card featured">

            <div
              class="card-watermark adultos-watermark"
              aria-hidden="true"
            ></div>

            <div class="card-content">

              <div class="card-top">

                <p class="card-label">
                  FORMACIÓN JUVENIL Y ADULTOS
                </p>

                <h3>
                  11 AÑOS
                  <span>EN ADELANTE</span>
                </h3>

              </div>


              <div class="gold-line left"></div>


              <div class="schedule-list">


                <div class="schedule-item">

                  <div class="day">

                    <strong>
                      MARTES Y JUEVES
                    </strong>

                    <span>
                      ENTRENAMIENTO
                    </span>

                  </div>

                  <div class="time">
                    7:00 p. m.
                    <small>—</small>
                    8:30 p. m.
                  </div>

                </div>


                <div class="schedule-item">

                  <div class="day">

                    <strong>
                      SÁBADOS Y DOMINGOS
                    </strong>

                    <span>
                      ENTRENAMIENTO
                    </span>

                  </div>

                  <div class="time">
                    7:00 a. m.
                    <small>—</small>
                    8:30 a. m.
                  </div>

                </div>


              </div>


              <a
                href="/contacto"
                class="schedule-button"
              >
                QUIERO ENTRENAR
                <span>→</span>
              </a>

            </div>

          </article>


        </div>

      </div>

    </section>


    <!-- =========================================================
         NOTA
    ========================================================== -->
    <section class="training-note section-block">

      <div class="container">

        <div class="note-card">

          <div class="note-content">

            <p class="section-label">
              DISCIPLINA Y CONSTANCIA
            </p>

            <h2 class="section-title">
              CADA ENTRENAMIENTO <br>
              <span>ES UN PASO MÁS.</span>
            </h2>

            <div class="gold-line left"></div>

            <p>
              Nuestro objetivo es que cada estudiante encuentre
              en el entrenamiento un espacio para crecer, aprender
              y fortalecer su carácter.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================================
         VALORES
    ========================================================== -->
    <section class="values-section section-block alt-bg">

      <div class="container">

        <div class="section-heading">

          <p class="section-label">
            NUESTROS VALORES
          </p>

          <h2 class="section-title">
            ENTRENAMOS EL CUERPO, <br>
            <span>FORMAMOS EL CARÁCTER</span>
          </h2>

          <div class="gold-line"></div>

        </div>


        <div class="values-grid">


          <article class="value-card">

            <h3>
              CORTESÍA
            </h3>

            <p>
              Tratamos a los demás con respeto y consideración.
            </p>

            <span class="value-arrow">
              →
            </span>

          </article>


          <article class="value-card">

            <h3>
              INTEGRIDAD
            </h3>

            <p>
              Actuamos con honestidad dentro y fuera del tatami.
            </p>

            <span class="value-arrow">
              →
            </span>

          </article>


          <article class="value-card">

            <h3>
              PERSEVERANCIA
            </h3>

            <p>
              Seguimos adelante incluso cuando el camino es difícil.
            </p>

            <span class="value-arrow">
              →
            </span>

          </article>


          <article class="value-card">

            <h3>
              AUTOCONTROL
            </h3>

            <p>
              Aprendemos a dominar nuestro cuerpo, mente y emociones.
            </p>

            <span class="value-arrow">
              →
            </span>

          </article>


          <article class="value-card">

            <h3>
              ESPÍRITU INDOMABLE
            </h3>

            <p>
              Enfrentamos los retos con determinación y fortaleza.
            </p>

            <span class="value-arrow">
              →
            </span>

          </article>


        </div>

      </div>

    </section>


    <!-- =========================================================
         CTA FINAL
    ========================================================== -->
    <section class="cta-section">

      <div class="container text-center">

        <p class="section-label">
          TU CAMINO COMIENZA AQUÍ
        </p>

        <h2 class="section-title">
          ¿LISTO PARA <br>
          <span>ENTRENAR CON NOSOTROS?</span>
        </h2>

        <p class="cta-description">
          Da el primer paso y conoce todo lo que Saeroon Do
          puede aportar a tu formación.
        </p>

        <a
          href="/contacto"
          class="button gold"
        >
          QUIERO SER PARTE
          <span>→</span>
        </a>

      </div>

    </section>

  </main>

</Layout>


<style>

  /* =========================================================
     BASE
  ========================================================== */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #031215;
    color: #ffffff;
    font-family: "Montserrat", sans-serif;
  }


  /* =========================================================
     CONTENEDOR
  ========================================================== */

  .container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }


  /* =========================================================
     HERO
  ========================================================== */

  .schedule-hero {
    position: relative;
    min-height: 600px;

    display: flex;
    align-items: center;

    overflow: hidden;

    background:
      linear-gradient(
        135deg,
        #06191c 0%,
        #0a292e 55%,
        #031215 100%
      );
  }

  .schedule-hero::before {
    content: "";

    position: absolute;
    width: 600px;
    height: 600px;

    right: -200px;
    top: 50%;

    transform: translateY(-50%);

    border-radius: 50%;

    background: #d6a528;

    opacity: 0.08;

    filter: blur(80px);
  }

  .schedule-hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(3,18,21,.90) 0%,
        rgba(3,18,21,.55) 55%,
        rgba(3,18,21,.20) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;

    width: min(1200px, 92%);
    margin: 0 auto;

    padding-top: 65px;

    display: grid;
    grid-template-columns: 1fr 0.8fr;

    align-items: center;

    gap: 60px;
  }

  .hero-text {
    max-width: 680px;
  }

  .quote-korean {
    margin: 0 0 14px;

    color: #d6a528;

    font-family: "Montserrat", sans-serif;
    font-size: 18px;
    font-weight: 600;

    letter-spacing: 5px;
  }

  .section-label {
    margin: 0 0 14px;

    color: #d6a528;

    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 800;

    letter-spacing: 2px;
  }

  .schedule-hero h1 {
    margin: 0;

    color: #ffffff;

    font-family: "Rock Salt", cursive;

    font-size: clamp(30px, 3.8vw, 50px);

    font-weight: 400;

    line-height: 1.4;
  }

  .schedule-hero h1 span {
    display: block;
    color: #d6a528;
  }

  .hero-description {
    max-width: 600px;

    margin: 24px 0 0;

    color: rgba(255,255,255,.82);

    font-family: "Montserrat", sans-serif;

    font-size: 14px;
    line-height: 1.8;
  }


  /* =========================================================
     IMAGEN HERO
  ========================================================== */

.hero-image {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
}

.hero-image img {
  display: block;
  width: 100%;
  height: auto;
  max-width: 520px;
  object-fit: contain;
  border: none;
  border-radius: 0;
  box-shadow: none;
  filter: drop-shadow(0 20px 35px rgba(0, 0, 0, 0.35));

  -webkit-mask-image:
    linear-gradient(
      to right,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    ),
    linear-gradient(
      to bottom,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );

  -webkit-mask-composite: source-in;

  mask-image:
    linear-gradient(
      to right,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    ),
    linear-gradient(
      to bottom,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );

  mask-composite: intersect;
}

  /* =========================================================
     SECCIONES
  ========================================================== */

  .section-block {
    padding: 80px 0;

    background: #031215;
  }

  .alt-bg {
    background: #051b1f;
  }

  .section-heading {
    margin-bottom: 40px;
  }

  .section-title {
    margin: 0 0 18px;

    color: #ffffff;

    font-family: "Rock Salt", cursive;

    font-size: clamp(24px, 2.7vw, 34px);

    font-weight: 400;

    line-height: 1.45;
  }

  .section-title span {
    color: #d6a528;
  }

  .section-description {
    max-width: 720px;

    margin: 0;

    color: rgba(255,255,255,.76);

    font-family: "Montserrat", sans-serif;

    font-size: 14px;
    line-height: 1.8;
  }

  .gold-line {
    width: 60px;
    height: 3px;

    margin: 15px 0 22px;

    background: #d6a528;
  }

  .gold-line.left {
    margin-left: 0;
  }


  /* =========================================================
     INTRO
  ========================================================== */

  .intro {
    text-align: center;
  }

  .intro .gold-line {
    margin-left: auto;
    margin-right: auto;
  }

  .intro-text {
    max-width: 760px;

    margin: 0 auto;

    color: rgba(255,255,255,.78);

    font-family: "Montserrat", sans-serif;

    font-size: 14px;

    line-height: 1.8;
  }


  /* =========================================================
     HORARIOS
  ========================================================== */

  .schedule-grid {

    display: grid;

    grid-template-columns:
      repeat(2, 1fr);

    gap: 25px;
  }

  .schedule-card {

    position: relative;

    overflow: hidden;

    padding: 40px;

    background:
      linear-gradient(
        145deg,
        #09282e,
        #06191c
      );

    border:
      1px solid
      rgba(214,165,40,.28);

    border-radius: 10px;

    transition:
      transform .35s ease,
      border-color .35s ease,
      box-shadow .35s ease,
      background .35s ease;
  }

  .schedule-card:hover {

    transform:
      translateY(-7px) scale(1.008);

    border-color:
      #d6a528;

    background:
      linear-gradient(
        145deg,
        #0b2d33,
        #071d20
      );

    box-shadow:
      0 20px 45px rgba(0,0,0,.30),
      0 0 28px rgba(214,165,40,.12);
  }

  .schedule-card::after {

    content: "";

    position: absolute;

    left: 40px;
    bottom: 0;

    width: 0;
    height: 2px;

    background: #d6a528;

    transition:
      width .35s ease;
  }

  .schedule-card:hover::after {

    width:
      calc(100% - 80px);
  }


  /* =========================================================
     MARCAS DE AGUA
  ========================================================== */

  .card-watermark {

    position: absolute;

    inset: 0;

    background-repeat:
      no-repeat;

    background-position:
      center;

    background-size:
      72%;

    opacity:
      .12;

    pointer-events:
      none;

    transition:
      transform .5s ease,
      opacity .5s ease;
  }

  .infantil-watermark {

    background-image:
      url("/images/Menor 4.png");
  }

  .adultos-watermark {

    background-image:
      url("/images/Mayor 15.png");
  }

  .schedule-card:hover
  .card-watermark {

    transform:
      scale(1.06);

    opacity:
      .17;
  }


  /* =========================================================
     CONTENIDO CARD
  ========================================================== */

  .card-content {

    position:
      relative;

    z-index:
      2;
  }

  .card-top {
    position: relative;
  }

  .card-number {

    display: block;

    margin-bottom: 8px;

    color:
      rgba(214,165,40,.72);

    font-family:
      "Montserrat", sans-serif;

    font-size:
      12px;

    font-weight:
      800;

    letter-spacing:
      1.5px;

    transition:
      transform .3s ease,
      color .3s ease;
  }

  .schedule-card:hover
  .card-number {

    color:
      #d6a528;

    transform:
      translateX(5px);
  }

  .card-label {

    margin: 0 0 12px;

    color:
      #d6a528;

    font-family:
      "Montserrat", sans-serif;

    font-size:
      10px;

    font-weight:
      800;

    letter-spacing:
      1.5px;
  }

  .schedule-card h3 {

    margin: 0;

    color:
      #ffffff;

    font-family:
      "Rock Salt", cursive;

    font-size:
      clamp(24px, 2.7vw, 34px);

    font-weight:
      400;

    line-height:
      1.45;
  }

  .schedule-card h3 span {

    display:
      block;

    color:
      #d6a528;
  }


  /* =========================================================
     LISTA
  ========================================================== */

  .schedule-list {

    margin-top:
      25px;

    padding:
      5px 20px;

    background:
      rgba(0,0,0,.20);

    border-left:
      3px solid #d6a528;
  }

  .schedule-item {

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      20px;

    padding:
      18px 0;

    border-bottom:
      1px solid
      rgba(255,255,255,.10);
  }

  .schedule-item:last-child {

    border-bottom:
      0;
  }

  .day {

    display:
      flex;

    flex-direction:
      column;

    gap:
      6px;
  }

  .day strong {

    color:
      #ffffff;

    font-family:
      "Montserrat", sans-serif;

    font-size:
      10px;

    font-weight:
      800;

    letter-spacing:
      .4px;
  }

  .day span {

    color:
      rgba(255,255,255,.45);

    font-family:
      "Montserrat", sans-serif;

    font-size:
      9px;

    font-weight:
      600;

    letter-spacing:
      1px;
  }

  .time {

    color:
      #d6a528;

    font-family:
      "Montserrat", sans-serif;

    font-size:
      12px;

    font-weight:
      800;

    text-align:
      right;

    white-space:
      nowrap;
  }

  .time small {

    color:
      rgba(255,255,255,.45);

    padding:
      0 4px;
  }


  /* =========================================================
     BOTÓN
  ========================================================== */

  .schedule-button {

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      12px;

    min-height:
      46px;

    margin-top:
      25px;

    padding:
      0 21px;

    background:
      #d6a528;

    color:
      #031215 !important;

    border:
      1px solid #d6a528;

    text-decoration:
      none;

    font-family:
      "Montserrat", sans-serif;

    font-size:
      10px;

    font-weight:
      800;

    letter-spacing:
      .8px;

    transition:
      transform .3s ease,
      background .3s ease,
      border-color .3s ease,
      box-shadow .3s ease;
  }

  .schedule-button span {

    font-size:
      17px;

    transition:
      transform .3s ease;
  }

  .schedule-button:hover {

    transform:
      translateY(-3px);

    background:
      #edcc70;

    border-color:
      #edcc70;

    box-shadow:
      0 12px 28px
      rgba(214,165,40,.20);
  }

  .schedule-button:hover span {

    transform:
      translateX(4px);
  }


  /* =========================================================
     NOTA
  ========================================================== */

  .note-card {

    position:
      relative;

    display:
      grid;

    grid-template-columns:
      auto 1fr;

    align-items:
      center;

    gap:
      35px;

    padding:
      45px;

    background:
      #082329;

    border:
      1px solid
      rgba(214,165,40,.28);

    border-radius:
      10px;

    transition:
      transform .35s ease,
      border-color .35s ease,
      box-shadow .35s ease;
  }

  .note-card:hover {

    transform:
      translateY(-6px);

    border-color:
      #d6a528;

    box-shadow:
      0 18px 40px
      rgba(0,0,0,.28),
      0 0 25px
      rgba(214,165,40,.10);
  }

  .note-number {

    color:
      rgba(214,165,40,.70);

    font-family:
      "Montserrat", sans-serif;

    font-size:
      14px;

    font-weight:
      800;

    letter-spacing:
      2px;
  }

  .note-content h2 {

    margin-bottom:
      15px;
  }

  .note-content > p:last-child {

    max-width:
      720px;

    margin:
      0;

    color:
      rgba(255,255,255,.72);

    font-family:
      "Montserrat", sans-serif;

    font-size:
      14px;

    line-height:
      1.8;
  }


  /* =========================================================
     VALORES
  ========================================================== */

  .values-grid {

    display:
      grid;

    grid-template-columns:
      repeat(5,1fr);

    gap:
      15px;
  }

  .value-card {

    position:
      relative;

    min-height:
      220px;

    padding:
      25px 20px 35px;

    background:
      #082329;

    border:
      1px solid
      rgba(214,165,40,.25);

    border-radius:
      8px;

    overflow:
      hidden;

    transition:
      transform .35s ease,
      border-color .35s ease,
      box-shadow .35s ease,
      background .35s ease;
  }

  .value-card:hover {

    transform:
      translateY(-7px) scale(1.02);

    background:
      #09282e;

    border-color:
      #d6a528;

    box-shadow:
      0 16px 35px
      rgba(0,0,0,.28),
      0 0 25px
      rgba(214,165,40,.12);
  }

  .value-card::after {

    content:
      "";

    position:
      absolute;

    left:
      20px;

    bottom:
      0;

    width:
      0;

    height:
      2px;

    background:
      #d6a528;

    transition:
      width .35s ease;
  }

  .value-card:hover::after {

    width:
      calc(100% - 40px);
  }

  .value-number {

    display:
      block;

    color:
      rgba(214,165,40,.70);

    font-family:
      "Montserrat", sans-serif;

    font-size:
      11px;

    font-weight:
      800;

    letter-spacing:
      1.5px;

    transition:
      transform .3s ease,
      color .3s ease;
  }

  .value-card:hover
  .value-number {

    color:
      #d6a528;

    transform:
