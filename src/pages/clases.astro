 ---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Clases | Saeroon Do"
  description="Conoce las diferentes etapas de formación de Saeroon Do."
>

  <main>

    <!-- =========================================================
         HERO
    ========================================================== -->

   <section class="classes-hero">
  <div class="classes-hero-content">

        <div class="hero-text-content">

          <p
            class="quote-korean"
            lang="ko"
          >
            새로운도
          </p>

          <p class="section-label">
            SAEROON DO
          </p>

          <h1>
            NUESTRO CAMINO
            <span>DE FORMACIÓN</span>
          </h1>

          <p class="hero-description">
            Cada etapa del Taekwondo representa una oportunidad
            para crecer, aprender y construir una mejor versión
            de nosotros mismos.
          </p>

        </div>


        <div class="classes-hero-image">

          <img
            src="/images/clases-saeroondo.png"
            alt="Saeroon Do - Nuestro camino de formación"
            loading="eager"
          />

        </div>

      </div>

    </section>


    <!-- =========================================================
         INTRODUCCIÓN
    ========================================================== -->

    <section class="intro section-block">

      <div class="container">

        <p class="section-label">
          TAEKWONDO PARA TODOS
        </p>

        <h2 class="section-title">
          FORMAMOS <br>
          <span>PERSONAS</span>
        </h2>

        <div class="gold-line"></div>

        <p class="intro-text">

          En <strong>Saeroon Do</strong> creemos que el Taekwondo es un camino
          que puede ser recorrido por todos.<br />

          Cada estudiante es único, con sus propias capacidades, ritmos,
          fortalezas, desafíos y sueños.<br />

          Por eso construimos un espacio
          <strong>inclusivo, respetuoso y seguro</strong>, donde cada persona
          pueda aprender, participar y avanzar desde sus propias posibilidades.

          <br />
          <br />

          No buscamos que todos avancen de la misma manera,
          <strong>buscamos que cada uno pueda avanzar</strong>.

          Adaptamos nuestra enseñanza para acompañar las diferentes necesidades
          de nuestros estudiantes, promoviendo el respeto por las diferencias
          y el valor de trabajar juntos.

        </p>

      </div>

    </section>


    <!-- =========================================================
         ETAPAS DE FORMACIÓN
    ========================================================== -->

    <section class="formation-section section-block alt-bg">

      <div class="container">

        <div class="section-heading">

          <p class="section-label">
            NUESTRO PROGRAMA
          </p>

          <h2 class="section-title">
            ETAPAS DE <br>
            <span>FORMACIÓN</span>
          </h2>

          <div class="gold-line"></div>

          <p class="section-description">
            Diseñamos nuestras clases para acompañar a cada estudiante
            de acuerdo con su etapa, sus capacidades y sus objetivos.
          </p>

        </div>


        <div class="formation-grid">

          <article class="formation-card">

            <div class="formation-content">

              <div class="formation-top">

                <p class="formation-label">
                  PRIMERA ETAPA
                </p>

              </div>


              <h3 class="formation-title">
                FORMACIÓN
                <span>INFANTIL</span>
              </h3>

              <div class="gold-line left"></div>


              <p class="formation-description">
                Un espacio pensado para que los más pequeños
                descubran el Taekwondo de una manera segura,
                dinámica y formativa.
              </p>


              <div class="formation-features">

                <div class="feature-item">
                  <span>01</span>
                  <p>Disciplina y hábitos positivos</p>
                </div>

                <div class="feature-item">
                  <span>02</span>
                  <p>Coordinación y desarrollo físico</p>
                </div>

                <div class="feature-item">
                  <span>03</span>
                  <p>Respeto y convivencia</p>
                </div>

                <div class="feature-item">
                  <span>04</span>
                  <p>Confianza y perseverancia</p>
                </div>

              </div>


              <div class="formation-age">

                <span>
                  EDAD
                </span>

                <strong>
                  4 A 10 AÑOS
                </strong>

              </div>


              <a
                href="/contacto"
                class="formation-button"
              >
                QUIERO INSCRIBIRME
                <span>→</span>
              </a>

            </div>

          </article>


          <article class="formation-card featured">

            <div class="formation-content">

              <div class="formation-top">

                <p class="formation-label">
                  SEGUNDA ETAPA
                </p>

              </div>


              <h3 class="formation-title">
                FORMACIÓN
                <span>JUVENIL Y ADULTOS</span>
              </h3>

              <div class="gold-line left"></div>


              <p class="formation-description">
                Un entrenamiento orientado al crecimiento físico,
                técnico y mental, llevando los principios del
                Taekwondo a los desafíos de la vida cotidiana.
              </p>


              <div class="formation-features">

                <div class="feature-item">
                  <span>01</span>
                  <p>Preparación física</p>
                </div>

                <div class="feature-item">
                  <span>02</span>
                  <p>Desarrollo técnico</p>
                </div>

                <div class="feature-item">
                  <span>03</span>
                  <p>Autocontrol e integridad</p>
                </div>

                <div class="feature-item">
                  <span>04</span>
                  <p>Espíritu indomable</p>
                </div>

              </div>


              <div class="formation-age">

                <span>
                  EDAD
                </span>

                <strong>
                  11 AÑOS EN ADELANTE
                </strong>

              </div>


              <a
                href="/contacto"
                class="formation-button"
              >
                QUIERO INSCRIBIRME
                <span>→</span>
              </a>

            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================================
         PILARES DEL TAEKWONDO
    ========================================================== -->

    <section class="pillars-section section-block">

      <div class="container">

        <div class="section-heading">

          <p class="section-label">
            NUESTROS VALORES
          </p>

          <h2 class="section-title">
            LOS 5 PILARES DEL <br>
            <span>TAEKWONDO</span>
          </h2>

          <div class="gold-line"></div>

          <p class="section-description">
            Los principios que orientan nuestra forma de entrenar,
            aprender y relacionarnos dentro y fuera del tatami.
          </p>

        </div>


        <div class="pillars-grid">

          <article class="pillar-card">

            <h3>
              CORTESÍA
            </h3>

            <p class="pillar-korean">
              Ye Ui
            </p>

            <p class="pillar-description">
              Tratamos a los demás con respeto y consideración.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>


          <article class="pillar-card">

            <h3>
              INTEGRIDAD
            </h3>

            <p class="pillar-korean">
              Yom Chi
            </p>

            <p class="pillar-description">
              Actuamos con honestidad dentro y fuera del tatami.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>


          <article class="pillar-card">

            <h3>
              PERSEVERANCIA
            </h3>

            <p class="pillar-korean">
              In Nae
            </p>

            <p class="pillar-description">
              Seguimos adelante incluso cuando el camino es difícil.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>


          <article class="pillar-card">

            <h3>
              AUTOCONTROL
            </h3>

            <p class="pillar-korean">
              Guk Gi
            </p>

            <p class="pillar-description">
              Aprendemos a dominar nuestro cuerpo, mente y emociones.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>


          <article class="pillar-card">

            <h3>
              ESPÍRITU INDOMABLE
            </h3>

            <p class="pillar-korean">
              Baekjul Boolgool
            </p>

            <p class="pillar-description">
              Enfrentamos los retos con determinación y fortaleza.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================================
         CTA FINAL
    ========================================================== -->

    <section class="cta-section">

      <div class="container text-center">

        <p class="section-label">
          TU CAMINO COMIENZA AQUÍ
        </p>

        <h2 class="section-title">
          ENCUENTRA TU <br>
          <span>CAMINO</span>
        </h2>

        <p class="cta-description">
          No importa dónde estés comenzando. Lo importante es dar
          el primer paso.
        </p>

        <a
          href="/contacto"
          class="button gold"
        >
          QUIERO SER PARTE
          <span aria-hidden="true">→</span>
        </a>

      </div>

    </section>

  </main>

</Layout>


<style>

:global(*) {
  box-sizing: border-box;
}

:global(body) {
  margin: 0;
  background: #031215;
  color: #ffffff;
  font-family: "Montserrat", sans-serif;
}


.container {
  width: min(1200px, 92%);
  margin: 0 auto;
}


.classes-hero {
  position: relative;

  min-height: 570px;

  display: flex;
  align-items: center;

  overflow: hidden;

  background: #031215;
}

.classes-hero-content {
  position: relative;

  z-index: 2;

  width: min(1200px, 92%);

  margin: 0 auto;

  padding-top: 70px;

  display: grid;

  grid-template-columns:
    1fr
    0.85fr;

  align-items: center;

  gap: 60px;
}

.hero-text-content {
  max-width: 680px;
}

.quote-korean {
  margin: 0 0 14px;

  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 18px;
  font-weight: 600;

  letter-spacing: 5px;
}

.section-label {
  margin: 0 0 14px;

  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 2px;
}

.classes-hero h1 {
  margin: 0;

  color: #ffffff;

  font-family: "Rock Salt", cursive;

  font-size: clamp(29px, 3.5vw, 48px);

  font-weight: 400;

  line-height: 1.4;
}

.classes-hero h1 span {
  display: block;

  color: #d6a528;
}

.hero-description {
  max-width: 600px;

  margin: 22px 0 0;

  color: rgba(255, 255, 255, 0.82);

  font-family: "Montserrat", sans-serif;

  font-size: 14px;

  line-height: 1.8;
}

.classes-hero {
  position: relative;
  min-height: 570px;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #031215;
}

.classes-hero-content {
  position: relative;
  z-index: 2;
  width: min(1200px, 92%);
  margin: 0 auto;
  padding-top: 70px;
  display: grid;
  grid-template-columns: 1fr 0.85fr;
  align-items: center;
  gap: 60px;
}

.hero-text-content {
  max-width: 680px;
}

.classes-hero-image {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.classes-hero-image::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      #031215 0%,
      rgba(3, 18, 21, 0.15) 18%,
      rgba(3, 18, 21, 0) 45%,
      rgba(3, 18, 21, 0.08) 72%,
      #031215 100%
    ),
    linear-gradient(
      180deg,
      #031215 0%,
      rgba(3, 18, 21, 0) 18%,
      rgba(3, 18, 21, 0) 80%,
      #031215 100%
    );
  pointer-events: none;
}

.classes-hero-image img {
  display: block;
  width: 100%;
  max-width: 520px;
  height: auto;
  border: none;
  border-radius: 0;
  box-shadow: none;
  object-fit: contain;
  filter: drop-shadow(0 20px 35px rgba(0, 0, 0, 0.35));
  -webkit-mask-image:
    linear-gradient(
      to right,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    ),
    linear-gradient(
      to bottom,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  -webkit-mask-composite: source-in;
  mask-image:
    linear-gradient(
      to right,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    ),
    linear-gradient(
      to bottom,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  mask-composite: intersect;
}

.section-block {
  padding: 80px 0;

  background: #031215;
}

.alt-bg {
  background: #051b1f;
}

.section-heading {
  margin-bottom: 42px;
}

.section-title {
  margin: 0 0 18px;

  color: #ffffff;

  font-family: "Rock Salt", cursive;

  font-size: clamp(24px, 2.7vw, 34px);

  font-weight: 400;

  line-height: 1.4;
}

.section-title span {
  color: #d6a528;
}

.gold-line {
  width: 60px;

  height: 3px;

  margin: 15px 0 22px;

  background: #d6a528;
}

.gold-line.left {
  margin-left: 0;
}


.intro {
  text-align: center;
}

.intro .section-label {
  margin-bottom: 15px;
}

.intro .gold-line {
  margin-left: auto;
  margin-right: auto;
}

.intro-text {
  max-width: 820px;

  margin: 0 auto;

  color: rgba(255, 255, 255, 0.80);

  font-family: "Montserrat", sans-serif;

  font-size: 14px;

  line-height: 1.85;
}

.intro-text strong {
  color: rgba(255, 255, 255, 0.96);

  font-weight: 800;
}


.formation-section {
  padding-top: 80px;

  padding-bottom: 90px;
}

.formation-grid {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 25px;
}

.formation-card {
  position: relative;

  overflow: hidden;

  padding: 38px;

  background: #082329;

  border:
    1px solid rgba(214, 165, 40, 0.28);

  border-radius: 10px;

  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease,
    background 0.35s ease;
}

.formation-card:hover {
  transform:
    translateY(-7px)
    scale(1.008);

  background: #09282e;

  border-color: #d6a528;

  box-shadow:
    0 20px 45px rgba(0, 0, 0, 0.30),
    0 0 30px rgba(214, 165, 40, 0.13);
}

.formation-card::after {
  content: "";

  position: absolute;

  left: 38px;

  bottom: 0;

  width: 0;

  height: 2px;

  background: #d6a528;

  transition:
    width 0.35s ease;
}

.formation-card:hover::after {
  width: calc(100% - 76px);
}

.formation-content {
  position: relative;

  z-index: 2;
}

.formation-top {
  display: flex;

  align-items: center;

  gap: 12px;
}

.formation-number {
  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: 1.5px;

  transition:
    transform 0.3s ease;
}

.formation-card:hover .formation-number {
  transform: translateX(5px);
}

.formation-label {
  margin: 0;

  color: rgba(214, 165, 40, 0.82);

  font-family: "Montserrat", sans-serif;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.7px;
}

.formation-title {
  margin: 18px 0 0;

  color: #ffffff;

  font-family: "Rock Salt", cursive;

  font-size: clamp(21px, 2.3vw, 28px);

  font-weight: 400;

  line-height: 1.45;
}

.formation-title span {
  display: block;

  color: #d6a528;
}

.formation-description {
  max-width: 500px;

  margin: 0 0 25px;

  color: rgba(255, 255, 255, 0.80);

  font-family: "Montserrat", sans-serif;

  font-size: 13px;

  line-height: 1.75;
}


.formation-features {
  margin: 25px 0;

  border-top:
    1px solid rgba(255, 255, 255, 0.10);
}

.feature-item {
  display: flex;

  align-items: center;

  gap: 15px;

  padding: 12px 0;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.10);
}

.feature-item span {
  min-width: 25px;

  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  font-weight: 800;
}

.feature-item p {
  margin: 0;

  color: rgba(255, 255, 255, 0.86);

  font-family: "Montserrat", sans-serif;

  font-size: 12px;

  font-weight: 500;

  line-height: 1.5;
}


.formation-age {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin: 25px 0;

  padding: 13px 0;

  border-top:
    1px solid rgba(214, 165, 40, 0.35);

  border-bottom:
    1px solid rgba(214, 165, 40, 0.35);
}

.formation-age span {
  color: rgba(255, 255, 255, 0.62);

  font-family: "Montserrat", sans-serif;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1px;
}

.formation-age strong {
  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: 0.7px;
}


.formation-button {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  min-height: 46px;

  padding: 0 21px;

  background: #d6a528;

  color: #031215 !important;

  border:
    1px solid #d6a528;

  text-decoration: none;

  font-family: "Montserrat", sans-serif;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 0.8px;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.formation-button span {
  font-size: 15px;

  transition:
    transform 0.3s ease;
}

.formation-button:hover {
  transform: translateY(-3px);

  background: #edcc70;

  border-color: #edcc70;

  box-shadow:
    0 12px 28px rgba(214, 165, 40, 0.20);
}

.formation-button:hover span {
  transform: translateX(4px);
}


.pillars-section {
  padding-top: 80px;

  padding-bottom: 90px;
}

.pillars-grid {
  display: grid;

  grid-template-columns:
    repeat(5, 1fr);

  gap: 16px;
}

.pillar-card {
  position: relative;

  overflow: hidden;

  min-height: 245px;

  padding: 26px 20px 24px;

  background: #082329;

  border:
    1px solid rgba(214, 165, 40, 0.27);

  border-radius: 8px;

  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease,
    background 0.35s ease;
}

.pillar-card:hover {
  transform:
    translateY(-7px)
    scale(1.02);

  background: #09282e;

  border-color: #d6a528;

  box-shadow:
    0 16px 35px rgba(0, 0, 0, 0.28),
    0 0 25px rgba(214, 165, 40, 0.13);
}

.pillar-card::after {
  content: "";

  position: absolute;

  left: 20px;

  bottom: 0;

  width: 0;

  height: 2px;

  background: #d6a528;

  transition:
    width 0.35s ease;
}

.pillar-card:hover::after {
  width: calc(100% - 40px);
}

.pillar-number {
  display: block;

  color: rgba(214, 165, 40, 0.72);

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 1.5px;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.pillar-card:hover .pillar-number {
  color: #d6a528;

  transform: translateX(4px);
}

.pillar-card h3 {
  margin: 15px 0 7px;

  color: #ffffff;

  font-family: "Montserrat", sans-serif;

  font-size: 14px;

  font-weight: 800;

  line-height: 1.35;
}

.pillar-korean {
  margin: 0 0 12px;

  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 0.5px;
}

.pillar-description {
  margin: 0;

  color: rgba(255, 255, 255, 0.72);

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  line-height: 1.65;
}

.pillar-arrow {
  position: absolute;

  right: 18px;

  bottom: 17px;

  color: rgba(214, 165, 40, 0.65);

  font-size: 17px;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.pillar-card:hover .pillar-arrow {
  color: #d6a528;

  transform: translateX(5px);
}


.cta-section {
  padding: 80px 0;

  background:
    linear-gradient(
      180deg,
      #051b1f 0%,
      #031215 100%
    );
}

.text-center {
  text-align: center;
}

.text-center .section-label {
  margin-bottom: 15px;
}

.text-center .section-title {
  max-width: 800px;

  margin-left: auto;

  margin-right: auto;
}

.cta-description {
  max-width: 600px;

  margin: 0 auto 28px;

  color: rgba(255, 255, 255, 0.76);

  font-family: "Montserrat", sans-serif;

  font-size: 14px;

  line-height: 1.7;
}

.button {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  min-height: 48px;

  padding: 0 24px;

  background: #d6a528;

  color: #031215 !important;

  border:
    1px solid #d6a528;

  text-decoration: none;

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.8px;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.button:hover {
  transform: translateY(-3px);

  background: #edcc70;

  border-color: #edcc70;

  box-shadow:
    0 12px 28px rgba(214, 165, 40, 0.20);
}

.button span {
  transition:
    transform 0.3s ease;
}

.button:hover span {
  transform: translateX(4px);
}


