 ---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Saeroon Do | Club de Taekwondo"
  description="Saeroon Do, un nuevo camino a través del Taekwondo."
>

  <main>

    <!-- =========================================================
         HERO
    ========================================================== -->

    <section class="hero">

      <div class="hero-background"></div>

      <div class="hero-overlay"></div>

      <div class="hero-content">

        <p class="hero-korean">
          새로운도
        </p>

        <p class="hero-label">
          CLUB DE TAEKWONDO
        </p>

        <h1 class="hero-title">
          MÁS QUE UN ARTE MARCIAL,
          <span>UN CAMINO PARA LA VIDA</span>
        </h1>

        <p class="hero-description">
          Un espacio para aprender Taekwondo, desarrollar disciplina,
          fortalecer el carácter y construir un camino de crecimiento
          personal y deportivo.
        </p>


        <div class="hero-actions">

          <a
            href="/clases"
            class="hero-button hero-button-primary"
          >
            CONOCE NUESTRAS CLASES
          </a>

          <a
            href="/contacto"
            class="hero-button hero-button-secondary"
          >
            ÚNETE A SAEROON DO
          </a>

        </div>

      </div>

    </section>


    <!-- =========================================================
         DISCIPLINA
    ========================================================== -->

    <section class="discipline-section">

      <div class="container">

        <p class="section-label">
          NUESTRO CAMINO
        </p>

        <h2 class="section-title">
          DISCIPLINA QUE <br>
          <span>TRANSFORMA</span>
        </h2>

        <div class="gold-line"></div>

        <p class="section-description">
          El Taekwondo es mucho más que una disciplina deportiva.
          Es una herramienta para desarrollar confianza, autocontrol,
          perseverancia y respeto.
        </p>


        <div class="audience-grid">

          <article class="audience-card">

            <p class="card-korean">
              어린이
            </p>

            <h3>
              NIÑOS
            </h3>

            <p>
              Desarrollamos disciplina, coordinación, confianza y respeto
              mientras los niños descubren todo su potencial.
            </p>

            <span class="card-arrow">
              →
            </span>

          </article>


          <article class="audience-card">

            <p class="card-korean">
              청소년
            </p>

            <h3>
              JÓVENES
            </h3>

            <p>
              Fortalecemos el carácter, el autocontrol y la perseverancia
              para enfrentar cada nuevo desafío.
            </p>

            <span class="card-arrow">
              →
            </span>

          </article>


          <article class="audience-card">

            <p class="card-korean">
              선수
            </p>

            <h3>
              DEPORTISTAS
            </h3>

            <p>
              Entrenamiento orientado al rendimiento, la competencia,
              la preparación física y el crecimiento deportivo.
            </p>

            <span class="card-arrow">
              →
            </span>

          </article>


          <article class="audience-card">

            <p class="card-korean">
              가족
            </p>

            <h3>
              FAMILIAS
            </h3>

            <p>
              Creamos espacios para compartir, aprender y crecer juntos
              alrededor de los valores del Taekwondo.
            </p>

            <span class="card-arrow">
              →
            </span>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================================
         PILARES
    ========================================================== -->

    <section class="pillars-section">

      <div class="container">

        <p class="section-label">
          LOS VALORES QUE NOS GUÍAN
        </p>

        <h2 class="section-title">
          LOS PILARES DEL <br>
          <span>TAEKWONDO</span>
        </h2>

        <div class="gold-line"></div>


        <div class="pillars-grid">

          <article class="pillar-card">

            <span class="pillar-symbol">
              仁
            </span>

            <h3>
              CORTESÍA
            </h3>

            <p>
              El respeto comienza en la forma en que tratamos a los demás.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>


          <article class="pillar-card">

            <span class="pillar-symbol">
              正
            </span>

            <h3>
              INTEGRIDAD
            </h3>

            <p>
              Actuamos con honestidad y coherencia dentro y fuera del tatami.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>


          <article class="pillar-card">

            <span class="pillar-symbol">
              忍
            </span>

            <h3>
              PERSEVERANCIA
            </h3>

            <p>
              Continuamos avanzando incluso cuando el camino se hace difícil.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>


          <article class="pillar-card">

            <span class="pillar-symbol">
              心
            </span>

            <h3>
              AUTOCONTROL
            </h3>

            <p>
              Aprendemos a dominar nuestro cuerpo, nuestra mente y nuestras emociones.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>


          <article class="pillar-card">

            <span class="pillar-symbol">
              勇
            </span>

            <h3>
              ESPÍRITU INDOMABLE
            </h3>

            <p>
              Enfrentamos los retos con determinación, fortaleza y valentía.
            </p>

            <span class="pillar-arrow">
              →
            </span>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================================
         CTA
    ========================================================== -->

    <section class="final-cta">

      <div class="container">

        <p class="section-label">
          TU CAMINO COMIENZA AQUÍ
        </p>

        <h2 class="section-title">
          DA EL PRIMER <br>
          <span>PASO</span>
        </h2>

        <p>
          Descubre una nueva forma de entrenar, aprender y crecer.
        </p>

        <a
          href="/contacto"
          class="cta-button"
        >
          QUIERO SER PARTE
          <span>→</span>
        </a>

      </div>

    </section>

  </main>

</Layout>


<style>

:global(*) {
  box-sizing: border-box;
}

:global(body) {
  margin: 0;
  background: #031215;
  color: #ffffff;
  font-family: "Montserrat", sans-serif;
}

.container {
  width: min(1200px, 92%);
  margin: auto;
}


/* =========================================================
   HERO
========================================================== */

.hero {
  position: relative;

  min-height: 720px;

  display: flex;
  align-items: center;

  overflow: hidden;
}

.hero-background {
  position: absolute;

  inset: 0;

  background-image:
    url("/images/inicio-hero-1.png");

  background-size: cover;

  background-position: center;

  background-repeat: no-repeat;
}

.hero-overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(3, 18, 21, 0.94) 0%,
      rgba(3, 18, 21, 0.70) 55%,
      rgba(3, 18, 21, 0.35) 100%
    ),
    linear-gradient(
      180deg,
      rgba(3, 18, 21, 0.20) 0%,
      rgba(3, 18, 21, 0.82) 100%
    );
}

.hero-content {
  position: relative;

  z-index: 2;

  width: min(1200px, 92%);

  margin: auto;

  padding-top: 70px;

  text-align: left;
}

.hero-korean {
  margin: 0 0 26px;

  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 18px;

  font-weight: 600;

  letter-spacing: 5px;
}

.hero-label {
  margin: 0 0 15px;

  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 2px;
}

.hero-title {
  max-width: 850px;

  margin: 0;

  color: #ffffff;

  font-family: "Rock Salt", cursive;

  font-size: clamp(27px, 3vw, 43px);

  font-weight: 400;

  line-height: 1.45;
}

.hero-title span {
  display: block;

  color: #d6a528;
}

.hero-description {
  max-width: 650px;

  margin: 24px 0 0;

  color: rgba(255, 255, 255, 0.82);

  font-family: "Montserrat", sans-serif;

  font-size: 14px;

  line-height: 1.8;
}


/* =========================================================
   BOTONES HERO
========================================================== */

.hero-actions {
  display: flex;

  flex-wrap: wrap;

  gap: 14px;

  margin-top: 30px;
}

.hero-button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 48px;

  padding: 0 24px;

  background: #d6a528;

  color: #031215;

  border:
    1px solid #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.8px;

  text-decoration: none;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.hero-button:hover {
  transform: translateY(-3px);

  background: #edcc70;

  color: #031215;

  border-color: #edcc70;

  box-shadow:
    0 12px 28px rgba(214, 165, 40, 0.20);
}


/* =========================================================
   SECCIONES
========================================================== */

.discipline-section,
.pillars-section {
  padding: 90px 0;

  background: #031215;
}

.section-label {
  margin: 0 0 14px;

  color: #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 2px;
}

.section-title {
  margin: 0;

  color: #ffffff;

  font-family: "Rock Salt", cursive;

  font-size: clamp(25px, 2.7vw, 35px);

  font-weight: 400;

  line-height: 1.45;
}

.section-title span {
  color: #d6a528;
}

.gold-line {
  width: 60px;

  height: 3px;

  margin: 18px 0 28px;

  background: #d6a528;
}

.section-description {
  max-width: 720px;

  margin: 0 0 45px;

  color: rgba(255, 255, 255, 0.75);

  font-size: 14px;

  line-height: 1.8;
}


/* =========================================================
   AUDIENCIA
========================================================== */

.audience-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 16px;
}

.audience-card {
  position: relative;

  min-height: 285px;

  padding: 26px 22px;

  overflow: hidden;

  background: #082329;

  border:
    1px solid rgba(214, 165, 40, 0.27);

  border-radius: 8px;

  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease,
    background 0.35s ease;
}

.audience-card:hover {
  transform:
    translateY(-7px)
    scale(1.02);

  background: #09282e;

  border-color: #d6a528;

  box-shadow:
    0 18px 38px rgba(0, 0, 0, 0.28),
    0 0 28px rgba(214, 165, 40, 0.13);
}

.audience-card::after {
  content: "";

  position: absolute;

  left: 20px;

  bottom: 0;

  width: 0;

  height: 2px;

  background: #d6a528;

  transition:
    width 0.35s ease;
}

.audience-card:hover::after {
  width: calc(100% - 40px);
}

.card-number {
  color: #d6a528;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 1.5px;

  transition:
    transform 0.3s ease;
}

.audience-card:hover .card-number {
  transform: translateX(4px);
}

.card-korean {
  margin: 18px 0 8px;

  color: #d6a528;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 1px;
}

.audience-card h3 {
  margin: 0 0 16px;

  color: #ffffff;

  font-family: "Montserrat", sans-serif;

  font-size: 15px;

  font-weight: 800;
}

.audience-card > p:last-of-type {
  margin: 0;

  color: rgba(255, 255, 255, 0.72);

  font-size: 11px;

  line-height: 1.7;
}

.card-arrow {
  position: absolute;

  right: 18px;

  bottom: 16px;

  color: rgba(214, 165, 40, 0.65);

  font-size: 18px;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.audience-card:hover .card-arrow {
  color: #d6a528;

  transform: translateX(5px);
}


/* =========================================================
   PILARES
========================================================== */

.pillars-section {
  background: #051b1f;
}

.pillars-grid {
  display: grid;

  grid-template-columns:
    repeat(5, 1fr);

  gap: 16px;
}

.pillar-card {
  position: relative;

  min-height: 245px;

  padding: 26px 20px;

  overflow: hidden;

  background: #082329;

  border:
    1px solid rgba(214, 165, 40, 0.27);

  border-radius: 8px;

  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease,
    background 0.35s ease;
}

.pillar-card:hover {
  transform:
    translateY(-7px)
    scale(1.02);

  background: #09282e;

  border-color: #d6a528;

  box-shadow:
    0 16px 35px rgba(0, 0, 0, 0.28),
    0 0 25px rgba(214, 165, 40, 0.13);
}

.pillar-card::after {
  content: "";

  position: absolute;

  left: 20px;

  bottom: 0;

  width: 0;

  height: 2px;

  background: #d6a528;

  transition:
    width 0.35s ease;
}

.pillar-card:hover::after {
  width: calc(100% - 40px);
}

.pillar-number {
  display: block;

  color: rgba(214, 165, 40, 0.72);

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 1.5px;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.pillar-card:hover .pillar-number {
  color: #d6a528;

  transform: translateX(4px);
}

.pillar-symbol {
  display: block;

  margin: 16px 0 8px;

  color: #d6a528;

  font-size: 21px;
}

.pillar-card h3 {
  margin: 0 0 12px;

  color: #ffffff;

  font-family: "Montserrat", sans-serif;

  font-size: 14px;

  font-weight: 800;
}

.pillar-card p {
  margin: 0;

  color: rgba(255, 255, 255, 0.72);

  font-size: 11px;

  line-height: 1.65;
}

.pillar-arrow {
  position: absolute;

  right: 18px;

  bottom: 16px;

  color: rgba(214, 165, 40, 0.65);

  font-size: 17px;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.pillar-card:hover .pillar-arrow {
  color: #d6a528;

  transform: translateX(5px);
}


/* =========================================================
   CTA FINAL
========================================================== */

.final-cta {
  padding: 90px 0;

  text-align: center;

  background:
    linear-gradient(
      180deg,
      #051b1f 0%,
      #031215 100%
    );
}

.final-cta .section-label {
  margin-bottom: 15px;
}

.final-cta .section-title {
  max-width: 700px;

  margin:
    0 auto 18px;
}

.final-cta > .container > p:not(.section-label) {
  max-width: 600px;

  margin:
    0 auto 28px;

  color: rgba(255, 255, 255, 0.76);

  font-size: 14px;

  line-height: 1.7;
}

.cta-button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 10px;

  min-height: 48px;

  padding: 0 24px;

  background: #d6a528;

  color: #031215 !important;

  border:
    1px solid #d6a528;

  font-family: "Montserrat", sans-serif;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.8px;

  text-decoration: none;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.cta-button:hover {
  transform: translateY(-3px);

  background: #edcc70;

  border-color: #edcc70;

  box-shadow:
    0 12px 28px rgba(214, 165, 40, 0.20);
}

.cta-button span {
  transition:
    transform 0.3s ease;
}

.cta-button:hover span {
  transform: translateX(4px);
}


/* =========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 1000px) {

  .audience-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .pillars-grid {
    grid-template-columns:
      repeat(3, 1fr);
  }

}


@media (max-width: 700px) {

  .hero {
    min-height: 650px;
  }

  .hero-content {
    padding-top: 80px;
  }

  .hero-title {
    font-size: 25px;
  }

  .hero-description {
    font-size: 13px;
  }

  .hero-actions {
    flex-direction: column;

    align-items: flex-start;
  }

  .hero-button {
    min-width: 220px;
  }

  .audience-grid {
    grid-template-columns: 1fr;
  }

  .pillars-grid {
    grid-template-columns: 1fr;
  }

  .discipline-section,
  .pillars-section,
  .final-cta {
    padding: 60px 0;
  }

  .section-title {
    font-size: 23px;
  }

}
</style>