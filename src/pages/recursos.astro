  .placeholder-icon {

    width: 44px;

    height: 44px;

    display: flex;

    align-items: center;

    justify-content: center;

    background:

      rgba(214, 165, 40, 0.07);

    border:

      1px solid

      rgba(214, 165, 40, 0.2);

    transition:

      transform 0.3s ease;

  }

  .photo-placeholder:hover .placeholder-icon {

    transform: scale(1.08);

  }

  .placeholder-icon svg {

    width: 23px;

    height: 23px;

  }

  .photo-placeholder span {

    font-family: "Montserrat", sans-serif;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 1px;

  }



  /* =========================================================

     CIERRE

  ========================================================== */

  .closing-section {

    padding: 70px 0 100px;

    background:

      radial-gradient(

        circle at center,

        rgba(214, 165, 40, 0.07),

