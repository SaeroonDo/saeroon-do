    color: rgba(255, 255, 255, 0.68);

    font-family: "Montserrat", sans-serif;

    font-size: 13px;

    line-height: 1.75;

  }



  /* =========================================================

     BOTÓN RECURSO

  ========================================================== */

  .resource-button {

    width: 100%;

    min-height: 48px;

    margin-top: 25px;

