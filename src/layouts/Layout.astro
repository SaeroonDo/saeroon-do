    <script
      src="https://cdn.jsdelivr.net/npm/counterapi/dist/counter.browser.min.js"
      defer
    ></script>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        const visitCount = document.getElementById("site-visit-count");

        if (!visitCount || typeof Counter === "undefined") {
          return;
        }

        const counter = new Counter({
          workspace: "informacion-club-deportivo-saeroon-dos-team-5540"
        });

        const sessionKey = "saeroon-do-visit-counted";

        async function updateVisitCount() {
          try {
            let result;

            if (!sessionStorage.getItem(sessionKey)) {
              result = await counter.up("saeroon-do");
              sessionStorage.setItem(sessionKey, "true");
            } else {
              result = await counter.get("saeroon-do");
            }

            const currentValue =
              result &&
              result.data &&
              result.data.up_count !== undefined
                ? result.data.up_count
                : result && result.value !== undefined
                  ? result.value
                  : undefined;

            if (currentValue !== undefined) {
              visitCount.textContent =
                Number(currentValue).toLocaleString("es-CO");
            }
          } catch (error) {
            console.error("Error al cargar el contador de visitas:", error);
            visitCount.textContent = "—";
          }
        }

        updateVisitCount();
      });
    </script>

